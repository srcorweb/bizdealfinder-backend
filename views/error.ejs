<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            text-align: center;
            font-family: Arial, sans-serif;
        }
        pre {
            text-align: left; 
            white-space: pre-wrap;
            background: #f4f4f4; 
            padding: 10px; 
            border: 1px solid #ddd;
            border-radius: 5px; 
            max-width: 80%; 
            margin: 20px auto; 
        }
    </style>
</head>
<body>
    <div>
        <h1>Error</h1>
        <p><%= message %></p>
        <% if (typeof error !== 'undefined') { %>
            <pre><%= error.stack %></pre>
        <% } %>
    </div>
</body>
</html>